# Copy to .env and fill in real values before running docker-compose
# Never commit .env to version control

# Database password (PostgreSQL)
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_a_real_secret

# Frontend origin(s) allowed to call the API (comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://yourdomain.com

# Supabase (optional — for cloud video storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Next.js frontend
JWT_SECRET=same_value_as_JWT_SECRET_KEY_above
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
